<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yaosheng.assistant.mapper.LightMapper">

    <update id="updateLight">
        update light
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="image != null">
                image = #{image},
            </if>
            <if test="statue != null">
                statue = #{statue},
            </if>
            <if test="brightness != null">
                brightness = #{brightness},
            </if>
        </set>
        where id = #{id}
    </update>
</mapper>